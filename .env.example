# Store Intelligence System environment template

# App mode
APP_NAME=Store Intelligence System
APP_ENV=development
DEMO_MODE=true

# Backend database
# Local development default:
DATABASE_URL=sqlite+aiosqlite:///./store_intelligence.db
# Example PostgreSQL value for Docker or production:
# DATABASE_URL=postgresql+asyncpg://store:store@db:5432/store_intelligence

# CORS: comma-separated list or JSON-like list string
ALLOWED_ORIGINS=["http://localhost:5173"]

# AI / video pipeline
YOLO_MODEL=yolov8n.pt
MAX_UPLOAD_MB=200
EVENT_OVERCROWD_THRESHOLD=8
EVENT_LINGER_SECONDS=20
EVENT_EXIT_GRACE_FRAMES=5
EVENT_CROWDING_COOLDOWN_SECONDS=20
EVENT_THEFT_RISK_COOLDOWN_SECONDS=10
EVENT_UNUSUAL_ACTIVITY_COOLDOWN_SECONDS=15
EVENT_LINGERING_COOLDOWN_SECONDS=30
EVENT_DENSITY_THRESHOLD=0.18

# Frontend API base URL
VITE_API_BASE=http://127.0.0.1:8000

# Optional PostgreSQL settings for local Docker/production deployments
POSTGRES_DB=store_intelligence
POSTGRES_USER=store
POSTGRES_PASSWORD=store